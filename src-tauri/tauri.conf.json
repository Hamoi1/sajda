{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Sajda",
  "version": "2.0.0",
  "identifier": "com.sajda.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Sajda",
        "url": "index.html",
        "width": 900,
        "height": 620,
        "minWidth": 800,
        "minHeight": 580,
        "decorations": false,
        "transparent": false,
        "backgroundColor": "#161c36",
        "center": true,
        "visible": false
      },
      {
        "label": "widget",
        "title": "Sajda Widget",
        "url": "index.html",
        "width": 300,
        "height": 116,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "focus": false,
        "visible": false
      },
      {
        "label": "reader",
        "title": "Sajda Reader",
        "url": "index.html",
        "width": 1000,
        "height": 720,
        "decorations": false,
        "transparent": false,
        "backgroundColor": "#10142a",
        "alwaysOnTop": false,
        "skipTaskbar": true,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "focus": false,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost https://api.github.com; img-src 'self' data:; media-src 'self' blob: data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:",
      "devCsp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Lifestyle",
    "shortDescription": "Prayer times and desktop widget",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
